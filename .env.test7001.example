# ──────────────────────────────────────────────────────────────────────────
# ArgoDesk — overlay per test in PARALLELO sulla porta 7001
#
# Serve a far girare il branch ArgoDesk accanto a un altro stack (es. il main
# sulla 7000) SENZA conflitti di porta o di dati. Le porte dei servizi e la
# cartella dati sono separate; i default del docker-compose restano invariati,
# quindi un normale `docker compose up` non e' toccato.
#
# USO (PowerShell), dalla cartella del progetto, sul branch:
#   Copy-Item .env .env.test7001          # parti dal tuo .env (chiavi LLM/API)
#   Get-Content .env.test7001.example | Add-Content .env.test7001   # appendi questi override
#   docker compose -p argodesk-test --env-file .env.test7001 up -d --build
#   # apri http://localhost:7001  (admin + password generata: docker compose -p argodesk-test logs argodesk)
#
# Per fermare SOLO il test (il main sulla 7000 resta su):
#   docker compose -p argodesk-test --env-file .env.test7001 down
#
# Nota: i valori che compaiono due volte in un .env vengono sovrascritti
# dall'ultima occorrenza, quindi appendere questo blocco rimappa porte e dati.
# ──────────────────────────────────────────────────────────────────────────

# Web UI del test sulla 7001 (il main resta sulla 7000)
APP_PORT=7001

# Porte host dei servizi bundlati, separate da quelle del main
CHROMADB_HOST_PORT=8101
SEARXNG_HOST_PORT=8081
NTFY_HOST_PORT=8092

# Cartelle dati/log DEDICATE al test: install pulito, non tocca ./data del main.
# (Cosi' eviti anche la confusione "memoria vuota": le collection ChromaDB sono
#  state rinominate argodesk_*, quindi su un data/ del vecchio Odysseus gli indici
#  vettoriali vanno ricostruiti. Un data dir nuovo parte pulito.)
ARGODESK_DATA_DIR=./data-test
ARGODESK_LOGS_DIR=./logs-test
